rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is a super admin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'super_admin';
    }

    // Helper function to check if a school is active (must exist and not be disabled/deleted)
    function isSchoolActive(schoolId) {
      return schoolId != null && 
        exists(/databases/$(database)/documents/schools/$(schoolId)) && 
        get(/databases/$(database)/documents/schools/$(schoolId)).data.get('disabled', false) != true &&
        get(/databases/$(database)/documents/schools/$(schoolId)).data.get('deleted', false) != true;
    }

    // Helper function to check if user belongs to the active school
    function isUserSchoolActive() {
      return request.auth != null && 
        isSchoolActive(request.auth.token.schoolId);
    }

    // Helper function to check if user is school admin of a specific school (only if active)
    function isSchoolAdmin(schoolId) {
      return request.auth != null && 
             request.auth.token.role == 'school_admin' && 
             request.auth.token.schoolId == schoolId &&
             isSchoolActive(schoolId);
    }

    // Helper function to check if user is a teacher or proctor in the specified school
    function isTeacherOrProctor(schoolId) {
      return request.auth != null && 
             (request.auth.token.role == 'teacher' || request.auth.token.role == 'proctor') && 
             request.auth.token.schoolId == schoolId &&
             isSchoolActive(schoolId);
    }

    // Helper function to check if user is a student in the specified school
    function isStudent(schoolId) {
      return request.auth != null && 
             request.auth.token.role == 'student' && 
             request.auth.token.schoolId == schoolId &&
             isSchoolActive(schoolId);
    }

    // Helper to check staff access (super_admin, school_admin, teacher, proctor) for school
    function isSchoolStaff(schoolId) {
      return isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacherOrProctor(schoolId);
    }

    // Helper to check any authenticated member of a school
    function isSchoolMember(schoolId) {
      return isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacherOrProctor(schoolId) || isStudent(schoolId);
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isSchoolAdmin(schoolId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meta', 'logoUrl', 'logoBase64', 'updatedAt'])
      );

      // Sub-collection for teachers
      match /teachers/{teacherId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // Sub-collection for students
      match /students/{studentId} {
        allow read: if isSuperAdmin() || 
                       isSchoolAdmin(schoolId) || 
                       isTeacherOrProctor(schoolId) || 
                       (isStudent(schoolId) && (request.auth.uid == resource.data.uid || request.auth.uid == studentId));
        allow create, delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow update: if isSuperAdmin() || isSchoolAdmin(schoolId) || (
          ((isStudent(schoolId) && request.auth.uid == resource.data.uid) || isTeacherOrProctor(schoolId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSession', 'updatedAt'])
        );
      }

      // Sub-collection for auditLogs (Immutable append-only log)
      match /auditLogs/{logId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow create: if (isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacherOrProctor(schoolId)) &&
                         request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Sub-collection for subjects
      match /subjects/{subjectId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // Sub-collection for classes
      match /classes/{classId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // Sub-collection for rooms
      match /rooms/{roomId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // Sub-collection for events
      match /events/{eventId} {
        allow read: if isSchoolMember(schoolId) || request.auth != null;
        allow create, delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow update: if isSuperAdmin() || isSchoolAdmin(schoolId) || isSchoolStaff(schoolId) || request.auth != null;

        match /sessions/{sessionId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSchoolStaff(schoolId) || request.auth != null;
        }

        match /timetable/{timetableId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSchoolStaff(schoolId) || request.auth != null;
        }

        match /proctors/{proctorId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSchoolStaff(schoolId) || request.auth != null;
        }

        match /allocations/{allocationId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSchoolStaff(schoolId);

          match /seats/{seatId} {
            allow read: if isSchoolMember(schoolId) || request.auth != null;
            allow write: if isSchoolStaff(schoolId);

            match /rooms/{roomId} {
              allow read: if isSchoolMember(schoolId) || request.auth != null;
              allow write: if isSchoolStaff(schoolId);
            }
          }

          match /rooms/{roomId} {
            allow read: if isSchoolMember(schoolId) || request.auth != null;
            allow write: if isSchoolStaff(schoolId);
          }
        }

        match /participants/{participantId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSchoolStaff(schoolId);
        }

        match /subjects/{subjectId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacherOrProctor(schoolId);

          match /questions/{questionId} {
            allow read: if isSchoolMember(schoolId) || request.auth != null;
            allow write: if isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacherOrProctor(schoolId);

            match /answerKey/{keyDocId} {
              allow read, write: if isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacherOrProctor(schoolId);
            }
          }
        }

        match /questions/{questionId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacherOrProctor(schoolId);

          match /answerKey/{keyDocId} {
            allow read, write: if isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacherOrProctor(schoolId);
          }
        }

        match /submissions/{submissionId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow create, update: if isSchoolStaff(schoolId) || (
            request.auth != null &&
            !request.resource.data.keys().hasAny(['score', 'finalScore', 'grade', 'verifiedBy', 'isVerified', 'proctorVerified'])
          );
          allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
        }

        match /attendances/{attendanceId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSchoolStaff(schoolId) || request.auth != null;
        }

        match /proctor_notes/{noteId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSchoolStaff(schoolId) || request.auth != null;
        }

        match /realtime_control/{controlId} {
          allow read, write: if isSchoolMember(schoolId) || request.auth != null;
        }

        match /makeup_approvals/{approvalId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow create: if isSchoolStaff(schoolId) || (
            request.auth != null &&
            request.resource.data.status == 'pending'
          );
          allow update: if isSchoolStaff(schoolId) || (
            request.auth != null &&
            request.resource.data.status == 'pending' &&
            resource.data.status == 'pending'
          );
          allow delete: if isSchoolStaff(schoolId);
        }

        match /makeup_sessions/{sessionId} {
          allow read: if isSchoolMember(schoolId) || request.auth != null;
          allow write: if isSchoolStaff(schoolId) || request.auth != null;
        }
      }

      // Sub-collection for event drafts (wizard auto-save)
      match /eventDrafts/{draftId} {
        allow read, write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }
    }

    match /_server_time/{docId} {
      allow read, write: if request.auth != null;
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Rules for archives collection
    match /archives/{schoolId} {
      allow read, write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      match /users/{archiveId} {
        allow read, write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }
    }

    // Rules for users collection
    match /users/{userId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        (request.auth.uid == userId && isUserSchoolActive()) ||
        (resource != null && isSchoolAdmin(resource.data.schoolId))
      );
      allow create: if isSuperAdmin() || (request.resource != null && isSchoolAdmin(request.resource.data.schoolId));
      allow update: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.schoolId));
      allow delete: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.schoolId));
    }

    match /{path=**}/bug_reports/{reportId} {
      allow read, write: if request.auth != null;
    }
  }
}
